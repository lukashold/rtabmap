# Copy to .env. Public OAuth client IDs are optional, never client secrets.
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# A random token of at least 32 characters enables the private server library.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave empty for a static viewer with no server project storage.
SERVER_TOKEN=
# Optional private reconstruction worker origin (never exposed to the browser).
# The reconstruction Compose override sets http://reconstruction:4180 internally.
RECONSTRUCTION_URL=
# Optional panorama/photo/video jobs: Compose 2.17+ and Docker BuildKit required.
# AI weights add ~1.68 GB plus an isolated CPU Torch runtime; allow 12 GiB RAM.
# Enable explicitly before docker compose ... up --build.
RECONSTRUCTION_ENABLE_GENERATION=0
RECONSTRUCTION_SPLAT_ITERATIONS=3000
RECONSTRUCTION_CAMERA_POLICY=auto
